# ---------------------------------------------------------------------------
# NAS / Docker deployment settings.
# Copy this file to `.env` (next to docker-compose.nas.yml) and change EVERY
# value below before going live. These are read automatically by docker compose.
# ---------------------------------------------------------------------------

# Password for the internal PostgreSQL database (pick a strong random one).
DB_PASSWORD=change-this-database-password

# Secret used to sign login sessions (make it long and random).
AUTH_SECRET=change-this-to-a-long-random-string

# The first administrator account, created automatically on first start.
ADMIN_EMAIL=you@yourfirm.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Your Name

# Optional: enable the live AI co-pilot by pasting an Anthropic API key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Port the app is served on (inside the NAS). Default 3000.
APP_PORT=3000
