# ----------------------------------------------------------------------------
# Smart Accounting Suite — environment configuration
# Copy this file to `.env` and adjust for your environment.
# ----------------------------------------------------------------------------

# Local PostgreSQL (matches docker-compose.yml). Point this at your physical
# server's PostgreSQL instance to self-host the data on your own hardware.
DATABASE_URL="postgresql://accounting:accounting@localhost:5432/accounting_suite?schema=public"

# Secret used to sign session cookies. Generate a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# ----------------------------------------------------------------------------
# AI features (optional). The app degrades gracefully with built-in heuristics
# when no key is present, so it still runs fully offline / air-gapped.
# Provide an Anthropic API key to enable the live AI co-pilot.
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Model used by the AI co-pilot. Defaults to a capable Claude model.
AI_MODEL="claude-opus-4-8"
